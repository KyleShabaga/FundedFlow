{
  "name": "@fundedflow/domain",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "description": "Framework-free FundedFlow domain contracts and primitives shared by every host.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:engine-runtimes": "node scripts/check-engine-runtimes.mjs",
    "fixtures:engine": "node scripts/generate-engine-contract-fixture.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vite": "^8.0.16"
  }
}
